<!DOCTYPE html>
<html lang="pt-pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JEOOTEC - Formação Profissional em Softwares de Gestão</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>
        :root { --primary-blue: #0056b3; --dark-blue: #0a192f; }
        .gradient-bg { background: linear-gradient(135deg, #0a192f 0%, #0056b3 100%); }
        .card-hover:hover { transform: translateY(-5px); transition: 0.3s; }
        .hero-image { height: 70vh; object-fit: cover; width: 100%; filter: brightness(0.7); }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans" x-data="jeootecApp()">

    <!-- HEADER/NAV -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="container mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center">
                <img src="https://i.ibb.co/LnmPZks/logo-jeootec.png" alt="JEOOTEC Logo" class="h-12">
            </div>
            <div class="hidden md:flex space-x-8 font-semibold">
                <a href="#home" class="hover:text-blue-600">Início</a>
                <a href="#bio" class="hover:text-blue-600">Sobre Mim</a>
                <a href="#cursos" class="hover:text-blue-600">Formações</a>
                <a href="#" @click="view = 'aluno'" class="hover:text-blue-600">Área do Aluno</a>
                <a href="#" @click="view = 'admin'" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">Painel Admin</a>
            </div>
        </div>
    </nav>

    <!-- VISTA PRINCIPAL (SITE) -->
    <div x-show="view === 'site'">
        
        <!-- SECÇÃO FOTO ENORME DE EQUIPA -->
        <section id="home" class="relative">
            <!-- Substitua pelo link da sua foto real de equipa formando -->
            <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=2071&auto=format&fit=crop" alt="Equipa JEOOTEC" class="hero-image">
            <div class="absolute inset-0 flex flex-col justify-center items-center text-center p-6 text-white bg-black/30">
                <h1 class="text-5xl md:text-7xl font-black uppercase mb-4 drop-shadow-lg italic">Equipa Formando JEOOTEC</h1>
                <p class="text-xl md:text-2xl font-semibold max-w-2xl drop-shadow-md">Transformando o futuro de Angola através da competência técnica avançada.</p>
            </div>
        </section>

        <!-- HERO SECTION (TEXTO E CTAs) -->
        <section class="gradient-bg text-white py-16">
            <div class="container mx-auto px-6 flex flex-col md:flex-row items-center">
                <div class="md:w-1/2 mb-10 md:mb-0">
                    <h2 class="text-4xl md:text-5xl font-bold mb-6 leading-tight uppercase">
                        Domine Softwares de Gestão e Abra Portas agora!
                    </h2>
                    <p class="text-lg mb-8 text-blue-100 italic">
                        "Estás sem emprego ou o salário não chega e procuras uma habilidade profissional que seja capaz de abrir qualquer porta?"
                    </p>
                    <div class="flex space-x-4">
                        <a href="#cursos" class="bg-white text-blue-900 px-8 py-3 rounded-full font-bold shadow-lg hover:bg-gray-100 uppercase transition">Ver Formações</a>
                        <a href="https://wa.me/244931352915" target="_blank" class="bg-green-500 text-white px-8 py-3 rounded-full font-bold shadow-lg hover:bg-green-600 uppercase flex items-center transition">
                            <i class="fab fa-whatsapp mr-2"></i> WhatsApp Direto
                        </a>
                    </div>
                </div>
                <div class="md:w-1/2 flex justify-center">
                    <div class="relative">
                        <div class="absolute -inset-4 bg-blue-400 opacity-20 rounded-full blur-xl"></div>
                        <img src="https://i.ibb.co/3s7mYBy/model-jeootec.jpg" alt="Rosto da Empresa" class="relative rounded-2xl shadow-2xl border-4 border-white/20 w-80 md:w-96">
                    </div>
                </div>
            </div>
        </section>

        <!-- SECÇÃO BIOGRAFIA DO FUNDADOR -->
        <section id="bio" class="py-20 bg-white border-b">
            <div class="container mx-auto px-6 flex flex-col md:flex-row gap-16 items-center">
                <div class="md:w-1/3">
                    <div class="border-8 border-blue-600 p-2 rounded-2xl shadow-2xl">
                        <!-- Foto do Fundador -->
                        <img src="https://i.ibb.co/3s7mYBy/model-jeootec.jpg" alt="Biografia Fundador" class="rounded-xl w-full">
                    </div>
                </div>
                <div class="md:w-2/3">
                    <h2 class="text-4xl font-black text-blue-900 mb-6 uppercase italic">Quem Somos e Porquê a JEOOTEC?</h2>
                    <div class="space-y-6 text-gray-700 leading-relaxed text-lg">
                        <p>Olá, eu sou <strong>[Seu Nome Aqui]</strong>, fundador da <strong>JEOOTEC</strong>. Com anos de experiência no mercado de tecnologias de gestão, percebi que existe um mercado que paga bem e quase ninguém fala: Técnicos e utilizadores de softwares de gestão empresarial.</p>
                        <p>A minha missão na JEOOTEC é ensinar-te a dominar em apenas dois dias os softwares mais usados e solicitados por pequenas e grandes empresas em Angola. Não ensinamos apenas a usar, ensinamos a instalar, configurar, vender e dar suporte nível empresa.</p>
                        <p><strong>BÔNUS:</strong> Alunos destaque têm possibilidade de trabalhar connosco ou serem recomendados para empresas clientes da nossa rede.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECÇÃO DE CURSOS -->
        <section id="cursos" class="py-20 container mx-auto px-6">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <h2 class="text-3xl font-bold text-gray-900 mb-4 italic">Escolha a Formação Ideal para o Seu Futuro Profissional</h2>
                <p class="text-gray-600 italic font-medium">Cada software é utilizado por diferentes tipos de empresas. Escolha o módulo que mais se adequa aos seus objetivos profissionais ou inscreva-se no pacote completo para obter uma formação mais abrangente e aumentar as suas oportunidades de emprego.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <template x-for="curso in cursos" :key="curso.id">
                    <div class="bg-white rounded-xl shadow-lg overflow-hidden card-hover border border-gray-100">
                        <div class="relative h-48 bg-gray-200">
                            <img :src="curso.imagem" class="w-full h-full object-cover">
                            <div class="absolute top-4 right-4">
                                <span :class="getStatusClass(curso.estado)" class="px-3 py-1 rounded-full text-xs font-bold text-white shadow-sm" x-text="curso.estado"></span>
                            </div>
                        </div>
                        <div class="p-6">
                            <h3 class="text-xl font-bold mb-2 text-blue-900 uppercase" x-text="curso.nome"></h3>
                            <p class="text-sm text-gray-600 mb-4 line-clamp-2 italic" x-text="curso.descricao"></p>
                            
                            <div class="space-y-2 mb-6">
                                <div class="flex items-center text-sm"><i class="fa-solid fa-layer-group w-6 text-blue-500"></i> <span x-text="'Módulos: ' + curso.modulosDisponiveis"></span></div>
                                <div class="flex items-center text-sm"><i class="fa-solid fa-clock w-6 text-blue-500"></i> <span x-text="curso.horario"></span></div>
                                <div class="flex items-center text-sm"><i class="fa-solid fa-users w-6 text-blue-500"></i> <span x-text="'Vagas Restantes: ' + curso.vagas"></span></div>
                                <div class="text-lg font-bold text-blue-600" x-text="curso.preco + ' Kz'"></div>
                            </div>

                            <div class="flex gap-2">
                                <button @click="openDetails(curso)" class="flex-1 border border-blue-600 text-blue-600 py-2 rounded-lg font-semibold hover:bg-blue-50 transition">Ver Detalhes</button>
                                <button @click="openInscricao(curso)" class="flex-1 bg-blue-600 text-white py-2 rounded-lg font-semibold hover:bg-blue-800 transition">Inscrever-me</button>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </section>
    </div>

    <!-- MODAL: DETALHES DO CURSO (MANTIDO) -->
    <div x-show="modalDetails" class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/60 overflow-y-auto">
        <div class="bg-white rounded-2xl max-w-2xl w-full p-8 relative">
            <button @click="modalDetails = false" class="absolute top-4 right-4 text-2xl">&times;</button>
            <div x-if="selectedCurso">
                <h2 class="text-3xl font-bold text-blue-900 mb-4 uppercase italic" x-text="selectedCurso.nome"></h2>
                <div class="grid md:grid-cols-2 gap-6 mb-6">
                    <div>
                        <h4 class="font-bold border-b mb-2 uppercase text-blue-600 text-sm tracking-widest">Objetivos</h4>
                        <p class="text-sm text-gray-600">Dominar a instalação, configuração e uso prático do sistema para nível empresarial.</p>
                        <h4 class="font-bold border-b mt-4 mb-2 uppercase text-blue-600 text-sm tracking-widest">Aprendizagem</h4>
                        <ul class="text-sm text-gray-600 list-disc ml-4 italic">
                            <li>Instalar e Configurar do Zero</li>
                            <li>Lançamento de Faturação</li>
                            <li>Configuração e suporte técnico</li>
                            <li>Venda do Software</li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="font-bold border-b mb-2 uppercase text-blue-600 text-sm tracking-widest">Perfil Profissional</h4>
                        <p class="text-sm text-gray-600">Contabilistas, Gestores, Técnicos de TI e Empreendedores.</p>
                        <h4 class="font-bold border-b mt-4 mb-2 uppercase text-blue-600 text-sm tracking-widest">Empresas</h4>
                        <p class="text-sm text-gray-600" x-text="selectedCurso.empresas"></p>
                    </div>
                </div>
                <div class="bg-blue-50 p-4 rounded-lg flex items-center justify-between border-l-4 border-blue-600">
                    <div>
                        <p class="text-xs uppercase font-bold text-blue-400">Certificação Oficial</p>
                        <p class="font-bold uppercase tracking-tighter">Certificado Profissional JEOOTEC</p>
                    </div>
                    <i class="fa-solid fa-certificate text-3xl text-blue-600"></i>
                </div>
                <button @click="modalDetails = false; openInscricao(selectedCurso)" class="w-full mt-6 bg-blue-600 text-white py-3 rounded-xl font-bold uppercase tracking-widest italic hover:bg-blue-800 transition">GARANTIR MINHA VAGA AGORA</button>
            </div>
        </div>
    </div>

    <!-- MODAL: FORMULÁRIO DE INSCRIÇÃO (COM ENVIO PARA WHATSAPP E EMAIL) -->
    <div x-show="modalInscricao" class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 overflow-y-auto">
        <div class="bg-white rounded-2xl max-w-4xl w-full max-h-[90vh] overflow-y-auto p-8 relative">
            <button @click="modalInscricao = false" class="absolute top-4 right-4 text-2xl font-bold">&times;</button>
            
            <h2 class="text-2xl font-black text-center mb-8 border-b pb-4 italic uppercase">Formulário de Inscrição JEOOTEC</h2>
            
            <form id="formInscricao" class="space-y-8" @submit.prevent="submitInscricao()">
                <div class="grid md:grid-cols-3 gap-4">
                    <div class="md:col-span-3"><h3 class="font-bold text-blue-600 uppercase text-xs tracking-widest">1. Dados Pessoais</h3></div>
                    <div class="md:col-span-2">
                        <label class="block text-[10px] font-bold mb-1 uppercase">Nome Completo</label>
                        <input type="text" x-model="formData.nome" class="w-full border p-2 rounded bg-gray-50 focus:ring-2 focus:ring-blue-600 outline-none" required>
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold mb-1 uppercase">Telefone / WhatsApp</label>
                        <input type="tel" x-model="formData.tel" class="w-full border p-2 rounded bg-gray-50 focus:ring-2 focus:ring-blue-600 outline-none" required placeholder="9xx xxx xxx">
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-[10px] font-bold mb-1 uppercase">E-mail</label>
                        <input type="email" x-model="formData.email" class="w-full border p-2 rounded bg-gray-50 focus:ring-2 focus:ring-blue-600 outline-none" required>
                    </div>
                </div>

                <div class="grid md:grid-cols-2 gap-4">
                    <div class="md:col-span-2"><h3 class="font-bold text-blue-600 uppercase text-xs tracking-widest">2. Escolha da Formação</h3></div>
                    <div>
                        <label class="block text-[10px] font-bold mb-1 uppercase">Software Selecionado</label>
                        <input type="text" :value="selectedCurso.nome" readonly class="w-full bg-blue-50 border p-2 rounded font-black text-blue-800">
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold mb-1 uppercase">Modalidade</label>
                        <select x-model="formData.modalidade" class="w-full border p-2 rounded bg-gray-50 outline-none">
                            <option>Utilizador Simples</option>
                            <option>Formação Profissional Completa (Instalação + Venda)</option>
                        </select>
                    </div>
                </div>

                <div class="border-2 border-dashed border-blue-200 p-6 rounded-xl bg-blue-50/30">
                    <h3 class="font-bold text-blue-600 uppercase text-xs mb-4 tracking-widest">3. Instruções de Pagamento</h3>
                    <p class="text-sm mb-4">Efectue a transferência do valor para o IBAN abaixo e envie o comprovativo pelo formulário ou WhatsApp.</p>
                    <div class="p-4 bg-white rounded border flex flex-col md:flex-row justify-between items-center gap-4">
                        <div>
                            <p class="text-[10px] uppercase font-bold text-gray-400">IBAN BAI (JEOOTEC):</p>
                            <p class="text-lg font-mono font-bold text-blue-900">AO06 0040 0000 1234 5678 1012 3</p>
                        </div>
                        <input type="file" class="text-xs">
                    </div>
                </div>

                <button type="submit" class="w-full bg-green-600 text-white py-4 rounded-xl font-black text-lg uppercase shadow-xl hover:bg-green-700 transition flex items-center justify-center gap-2">
                    <i class="fab fa-whatsapp"></i> Finalizar no WhatsApp e E-mail
                </button>
            </form>
        </div>
    </div>

    <!-- PAINEL ADMIN (MANTIDO) -->
    <div x-show="view === 'admin'" class="min-h-screen bg-gray-100 p-8">
        <div class="flex justify-between mb-8 items-center">
            <h1 class="text-3xl font-black text-blue-900 italic">CONTROLO ADMIN JEOOTEC</h1>
            <button @click="view = 'site'" class="bg-gray-800 text-white px-6 py-2 rounded-lg font-bold">Voltar ao Site</button>
        </div>
        <!-- ... Conteúdo do painel admin original ... -->
        <div class="bg-white rounded-2xl shadow-xl p-8">
            <h2 class="text-xl font-bold mb-4">Inscrições em Tempo Real</h2>
            <p class="text-gray-500 italic mb-8">Gerencie os alunos inscritos via WhatsApp e Email aqui.</p>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-blue-600 text-white uppercase text-xs tracking-widest">
                        <tr>
                            <th class="p-4">Aluno</th>
                            <th class="p-4">Curso</th>
                            <th class="p-4">Estado</th>
                            <th class="p-4">Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="border-b">
                            <td class="p-4 font-bold">João Manuel</td>
                            <td class="p-4 font-semibold italic text-blue-600">SOFTWARE XD</td>
                            <td class="p-4"><span class="bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-[10px] font-bold uppercase tracking-tighter">Pendente</span></td>
                            <td class="p-4"><button class="bg-green-500 text-white px-3 py-1 rounded font-bold text-xs">Confirmar</button></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- RODAPÉ -->
    <footer x-show="view === 'site'" class="bg-[#0a192f] text-white py-16">
        <div class="container mx-auto px-6 grid md:grid-cols-3 gap-12">
            <div>
                <img src="https://i.ibb.co/LnmPZks/logo-jeootec.png" alt="Logo" class="h-10 mb-6 brightness-200">
                <p class="text-gray-400 italic">"Transformando profissionais através da tecnologia. A única habilidade que vende soluções imediatas."</p>
            </div>
            <div>
                <h4 class="font-bold mb-4 uppercase text-blue-500 tracking-widest">Sede Central</h4>
                <p class="text-gray-400">Luanda, Angola</p>
                <p class="text-gray-400">WhatsApp: +244 931 352 915</p>
                <p class="text-gray-400">E-mail: jeootec@gmail.com</p>
            </div>
            <div>
                <h4 class="font-bold mb-4 uppercase text-blue-500 tracking-widest">Siga-nos</h4>
                <div class="flex space-x-6 text-2xl">
                    <a href="#" class="hover:text-blue-500"><i class="fab fa-facebook"></i></a>
                    <a href="#" class="hover:text-pink-500"><i class="fab fa-instagram"></i></a>
                    <a href="#" class="hover:text-green-400"><i class="fab fa-whatsapp"></i></a>
                </div>
            </div>
        </div>
        <div class="text-center mt-12 pt-8 border-t border-gray-800 text-gray-500 text-[10px] uppercase tracking-widest">
            &copy; 2024 JEOOTEC SOLUÇÕES TECNOLÓGICAS. Criado para Converter Profissionais.
        </div>
    </footer>

    <script>
        function jeootecApp() {
            return {
                view: 'site',
                modalDetails: false,
                modalInscricao: false,
                selectedCurso: {},
                formData: {
                    nome: '',
                    tel: '',
                    email: '',
                    modalidade: 'Utilizador Simples'
                },
                cursos: [
                    {
                        id: 1,
                        nome: 'SOFTWARE XD',
                        imagem: 'https://images.unsplash.com/photo-1556742049-13d736c7a91d?q=80&w=400',
                        descricao: 'O XD é utilizado por empresas de restauração, comércio e oficinas. Permite controlar vendas, produtos e faturação.',
                        modulosDisponiveis: 'Restauração, Faturação, Oficina',
                        preco: '25.000',
                        vagas: 8,
                        horario: 'Manhã (09h - 13h)',
                        estado: '✓ Inscrições Abertas',
                        empresas: 'Restaurantes, Supermercados, Oficinas Mecânicas.'
                    },
                    {
                        id: 2,
                        nome: 'SOFTWARE NEGOMIL',
                        imagem: 'https://images.unsplash.com/photo-1556740734-7f1a62791f05?q=80&w=400',
                        descricao: 'Solução moderna utilizada por restaurantes e hotéis para gestão operacional de faturação.',
                        modulosDisponiveis: 'Restauração, Faturação, Hoteleiro',
                        preco: '30.000',
                        vagas: 5,
                        horario: 'Tarde (14h - 18h)',
                        estado: '✓ Últimas Vagas',
                        empresas: 'Hotéis, Resorts, Pensões e Comércio.'
                    },
                    {
                        id: 3,
                        nome: 'SOFTWARE PRIMAVERA',
                        imagem: 'https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=400',
                        descricao: 'Reconhecido no mercado pela gestão de recursos humanos, contabilidade e faturação avançada.',
                        modulosDisponiveis: 'Contabilidade, RH, Faturação',
                        preco: '45.000',
                        vagas: 12,
                        horario: 'Sábados (09h - 16h)',
                        estado: '✓ Nova Turma em Breve',
                        empresas: 'Escritórios de Contabilidade, Bancos, Grandes Lojas.'
                    }
                ],
                openDetails(curso) {
                    this.selectedCurso = curso;
                    this.modalDetails = true;
                },
                openInscricao(curso) {
                    this.selectedCurso = curso;
                    this.modalInscricao = true;
                },
                getStatusClass(estado) {
                    if (estado.includes('Abertas')) return 'bg-green-600';
                    if (estado.includes('Vagas')) return 'bg-orange-500';
                    if (estado.includes('Breve')) return 'bg-blue-500';
                    return 'bg-red-600';
                },
                submitInscricao() {
                    const whatsappMsg = `Olá JEOOTEC! 🚀%0A%0A*NOVA INSCRIÇÃO FORMULÁRIO*%0A---------------------------%0A*Nome:* ${this.formData.nome}%0A*Curso:* ${this.selectedCurso.nome}%0A*Modalidade:* ${this.formData.modalidade}%0A*WhatsApp:* ${this.formData.tel}%0A*Email:* ${this.formData.email}%0A---------------------------%0AAguardando confirmação de pagamento.`;
                    
                    const waUrl = `https://api.whatsapp.com/send?phone=244931352915&text=${whatsappMsg}`;
                    
                    // Simulação de envio por e-mail via mailto (para sistemas reais usaria Formspree ou Backend)
                    const emailSubject = `Inscrição Formação JEOOTEC - ${this.formData.nome}`;
                    const emailBody = `Detalhes da Inscrição:\n\nNome: ${this.formData.nome}\nCurso: ${this.selectedCurso.nome}\nModalidade: ${this.formData.modalidade}\nWhatsApp: ${this.formData.tel}\nEmail: ${this.formData.email}`;
                    const mailUrl = `mailto:jeootec@gmail.com?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;

                    // Abrir WhatsApp
                    window.open(waUrl, '_blank');
                    
                    // Alerta de Sucesso
                    alert('Parabéns! Seus dados foram formatados. O WhatsApp será aberto para conclusão e enviamos uma cópia para o nosso e-mail.');
                    this.modalInscricao = false;
                }
            }
        }
    </script>
</body>
</html>
